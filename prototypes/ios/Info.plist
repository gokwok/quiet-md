<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key><string>quiet_md_ios</string>
    <key>CFBundleIdentifier</key><string>com.s1dashu.quietmd.prototype</string>
    <key>CFBundleDisplayName</key><string>Margin</string>
    <key>CFBundleName</key><string>Quiet.md Prototype</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>0.1.0</string>
    <key>CFBundleVersion</key><string>1</string>
    <key>NSFaceIDUsageDescription</key><string>用面容 ID 解锁 Margin。面容数据只由系统处理，Margin 不会读取或保存。</string>
    <key>NSCameraUsageDescription</key><string>拍一张照片作为文档的封面。照片只存在你的文档库里。</string>
    <key>CFBundleIcons</key>
    <dict>
        <key>CFBundlePrimaryIcon</key><dict><key>CFBundleIconFiles</key><array><string>AppIcon60x60</string></array></dict>
        <key>CFBundleAlternateIcons</key>
        <dict>
            <key>mo</key><dict><key>CFBundleIconFiles</key><array><string>IconMo</string></array></dict>
            <key>molv</key><dict><key>CFBundleIconFiles</key><array><string>IconMolv</string></array></dict>
            <key>dian</key><dict><key>CFBundleIconFiles</key><array><string>IconDian</string></array></dict>
            <key>qie</key><dict><key>CFBundleIconFiles</key><array><string>IconQie</string></array></dict>
            <key>zhe</key><dict><key>CFBundleIconFiles</key><array><string>IconZhe</string></array></dict>
            <key>wu</key><dict><key>CFBundleIconFiles</key><array><string>IconWu</string></array></dict>
            <key>xuan</key><dict><key>CFBundleIconFiles</key><array><string>IconXuan</string></array></dict>
        </dict>
    </dict>
    <!-- 生成配音切到后台也接着做（iOS 26 起的 BGContinuedProcessingTask）：标识是这个前缀加一个每次不同的后缀。 -->
    <key>BGTaskSchedulerPermittedIdentifiers</key><array><string>com.s1dashu.quietmd.prototype.voice.*</string></array>
    <key>MinimumOSVersion</key><string>17.0</string>
    <key>UILaunchScreen</key><dict/>
    <key>UISupportedInterfaceOrientations</key><array><string>UIInterfaceOrientationPortrait</string></array>
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key><false/>
        <key>UISceneConfigurations</key>
        <dict>
            <key>UIWindowSceneSessionRoleApplication</key>
            <array><dict>
                <key>UISceneConfigurationName</key><string>Default Configuration</string>
                <key>UISceneDelegateClassName</key><string>GPUIIosSceneDelegate</string>
            </dict></array>
        </dict>
    </dict>
    <key>LSSupportsOpeningDocumentsInPlace</key><true/>
    <!-- 应用自己的 iCloud 文件夹在 iCloud 云盘和「文件」里显示成「Quiet.md」：「存放位置」为 iCloud 的空间放在这里。 -->
    <key>NSUbiquitousContainers</key>
    <dict>
        <key>iCloud.com.s1dashu.quietmd</key>
        <dict>
            <key>NSUbiquitousContainerIsDocumentScopePublic</key><true/>
            <key>NSUbiquitousContainerName</key><string>Quiet.md</string>
            <key>NSUbiquitousContainerSupportedFolderLevels</key><string>Any</string>
        </dict>
    </dict>
</dict>
</plist>
