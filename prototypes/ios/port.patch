+/// 手机：被盖住的最近几页（`pin_shown`）的图片不放掉，返回时不用重新解码。
+const PINNED_PAGES: u64 = 3;
+thread_local! { static PIN: std::cell::Cell<u64> = const { std::cell::Cell::new(0) }; }
+fn pinned(pin: u64) -> bool { pin > 0 && pin + PINNED_PAGES > PIN.with(|p| p.get()) }
+/// 手机：要换页了（`ios::shot` 拍下这一页时）：这一页正画着的图片钉住，回到这一页时它们还在，
+/// 不会先空着再跳出来。只钉最近 `PINNED_PAGES` 页，更早的照常按时间、按大小放掉。
+pub fn pin_shown() {
+    let seq = PIN.with(|p| { p.set(p.get() + 1); p.get() });
+    FRAMES.with(|f| {
+        let f = f.borrow();
+        SLOTS.with(|m| if let Some(m) = m.borrow().as_ref() {
+            for s in m.borrow_mut().values_mut() {
+                if s.windows.iter().any(|(id, used)| f.get(id).is_some_and(|t| used >= t)) { s.pin = seq; }
+            }
+        });
+    });
+}
