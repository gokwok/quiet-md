+fn editor_surface() {
+    let sim = std::env::var("TARGET").unwrap().ends_with("-sim");
+    let sdk = if sim { "iphonesimulator" } else { "iphoneos" };
+    let triple = if sim { "arm64-apple-ios17.0-simulator" } else { "arm64-apple-ios17.0" };
+    let object = Path::new(&std::env::var("OUT_DIR").unwrap()).join("EditorSurface.o");
+    println!("cargo:rerun-if-changed=EditorSurface.m");
+    let status = std::process::Command::new("xcrun").args(["--sdk", sdk, "clang", "-target", triple, "-gline-tables-only", "-fobjc-arc", "-fmodules", "-c", "EditorSurface.m", "-o"]).arg(&object).status().unwrap();
+    assert!(status.success(), "UIKit editor controls failed to compile");
+    println!("cargo:rustc-link-arg={}", object.display());
+    if sim { simulator_entitlements(object.parent().unwrap()); }
+}
+
+fn simulator_entitlements(out: &Path) {
+    // Xcode 把模拟器的 entitlement 写进 Mach-O 段，钥匙串靠应用标识分开各个应用。
+    const VAR: &str = "QUIET_MD_IOS_SIM_BUNDLE";
+    let bundle = std::env::var(VAR).unwrap_or_else(|_| "com.s1dashu.quietmd.prototype".into());
+    assert!(bundle.bytes().all(|b| b.is_ascii_alphanumeric() || b".-".contains(&b)), "invalid simulator bundle id");
+    println!("cargo:rerun-if-env-changed={VAR}");
+    let xml = out.join("sim-entitlements.plist");
+    let der = out.join("sim-entitlements.der");
+    std::fs::write(&xml, format!(r#"<?xml version="1.0" encoding="UTF-8"?>
+<plist version="1.0"><dict><key>application-identifier</key><string>QUIETMDSIM.{bundle}</string></dict></plist>"#)).unwrap();
+    let status = std::process::Command::new("/usr/bin/derq").args(["query", "-f", "xml", "-i"]).arg(&xml).arg("-o").arg(&der).arg("--raw").status().unwrap();
+    assert!(status.success(), "simulator entitlements failed to encode");
+    for (section, file) in [("__entitlements", xml), ("__ents_der", der)] {
+        for arg in ["-Xlinker", "-sectcreate", "-Xlinker", "__TEXT", "-Xlinker", section, "-Xlinker", file.to_str().unwrap()] {
+            println!("cargo:rustc-link-arg={arg}");
+        }
+    }
+}
